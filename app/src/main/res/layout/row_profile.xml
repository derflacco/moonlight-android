<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:orientation="horizontal"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:padding="14dp"
    android:background="@drawable/deck_profile_row"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/deck_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/deck_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <RadioButton
        android:id="@+id/profileActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:buttonTint="@color/deck_accent" />

    <ImageButton
        android:id="@+id/editProfile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/deck_icon_button"
        android:contentDescription="Edit profile"
        android:padding="11dp"
        android:src="@drawable/ic_edit"
        android:tint="@color/deck_text_primary" />

    <ImageButton
        android:id="@+id/deleteProfile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/deck_icon_button"
        android:contentDescription="Delete profile"
        android:padding="11dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/deck_danger" />

</LinearLayout>