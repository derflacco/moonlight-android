<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deck_background"
    tools:context=".AppView">

    <ImageView
        android:id="@+id/gameHeroBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.24"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/deck_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/appHeader"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/appListText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:letterSpacing="0.02"
                android:preferKeepClear="true"
                android:textColor="@color/deck_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/backgroundButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/background_options_title"
                android:text="@string/background_button"
                android:textColor="@color/deck_text_primary"
                app:backgroundTint="@color/deck_surface_raised"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/deck_accent"
                app:rippleColor="@color/deck_ripple" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/profilesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:textColor="@color/deck_text_primary"
                app:backgroundTint="@color/deck_surface_raised"
                app:icon="@drawable/ic_profiles"
                app:iconTint="@color/deck_accent"
                app:rippleColor="@color/deck_ripple" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gameDetailsPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/gameLogo"
                android:layout_width="260dp"
                android:layout_height="88dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/title_game_library"
                android:textColor="@color/deck_text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/meta_sunshine_library"
                android:textColor="@color/deck_text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.04" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/gamePlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/title_game_play"
                android:textColor="@color/deck_text_primary"
                app:backgroundTint="@color/deck_accent"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/deck_text_primary"
                app:rippleColor="@color/deck_ripple" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/appFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="258dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>
</FrameLayout>