<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deck_background"
    android:padding="22dp"
    tools:context=".preferences.AddComputerManually">

    <TextView
        android:id="@+id/manuallyAddPcText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:letterSpacing="0.02"
        android:preferKeepClear="true"
        android:text="@string/title_add_pc"
        android:textColor="@color/deck_text_primary"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/addPcSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/manuallyAddPcText"
        android:layout_marginTop="7dp"
        android:text="@string/ip_hint"
        android:textColor="@color/deck_text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/hostTextView"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/addPcSubtitle"
        android:layout_marginTop="24dp"
        android:background="@drawable/deck_input_background"
        android:ems="10"
        android:hint="@string/ip_hint"
        android:inputType="textNoSuggestions"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/deck_text_primary"
        android:textColorHint="@color/deck_text_muted"
        android:preferKeepClear="true">

        <requestFocus />
    </EditText>

    <Button
        android:id="@+id/addPcButton"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_below="@id/hostTextView"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/deck_primary_button"
        android:minWidth="120dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:preferKeepClear="true"
        android:text="@android:string/ok"
        android:textAllCaps="false"
        android:textColor="@color/deck_background"
        android:textStyle="bold" />

</RelativeLayout>